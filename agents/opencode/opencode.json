{
    "$schema": "https://opencode.ai/config.json",
    "shell": "pwsh",
    "model": "openai/gpt-5.6-terra",
    "small_model": "deepseek/deepseek-v4-flash",
    "permission": {
        "read": {
            "*": "allow",
            "**/.env": "deny",
            "**/.env.*": "deny",
            "**/.env.example": "allow",
            "**/.env.sample": "allow",
            "**/.env.template": "allow",
            "**/auth.json": "deny",
            "**/credentials.json": "deny",
            "**/secrets.json": "deny",
            "**/token.json": "deny",
            "**/*.session": "deny",
            "**/*.session-journal": "deny",
            "**/.git-credentials": "deny",
            "**/.netrc": "deny",
            "**/id_rsa": "deny",
            "**/id_dsa": "deny",
            "**/id_ecdsa": "deny",
            "**/id_ed25519": "deny",
            "**/*.p12": "deny",
            "**/*.pfx": "deny",
            "**/*.kdbx": "deny",
            "**/logins.json": "deny",
            "**/key4.db": "deny",
            "**/cookies.sqlite": "deny"
        },
        "bash": {
            "*": "ask",
            "dotnet fsi *": "ask",
            "dotnet fsi \"C:/Users/andre/.config/opencode/skills/task/scripts/*": "allow",
            "dotnet fsi \"C:/Users/andre/.config/opencode/skills/office-documents/scripts/*": "ask",
            "dotnet fsi \"C:/Users/andre/.config/opencode/skills/audit-infra/scripts/*": "allow",
            "git branch --show-current": "allow",
            "git status *": "allow",
            "git remote -v": "allow",
            "git rev-parse *": "allow",
            "git ls-files *": "allow",
            "git ls-tree *": "allow",
            "git tag -l *": "allow",
            "dotnet --info*": "allow",
            "dotnet --version*": "allow",
            "npm run validate:infra": "allow",
            "git commit*": "ask",
            "git push*": "ask",
            "git reset --hard*": "deny",
            "git clean -fd*": "deny",
            "git clean -*": "deny",
            "git checkout -- *": "deny",
            "git restore *": "deny",
            "git -C * restore *": "deny",
            "rm -rf *": "deny",
            "Remove-Item * -Recurse -Force*": "deny",
            "Remove-Item -Recurse -Force *": "deny",
            "Remove-Item -LiteralPath * -Recurse -Force*": "deny"
        },
        "telegram_*": "ask",
        "github_*": "ask",
        "firefox_*": "ask",
        "firefox_read": "allow",
        "firefox_find": "allow",
        "firefox_close": "allow",
        "edit": "ask"
    },
    "mcp": {
        "telegram": {
            "type": "local",
            "enabled": false,
            "command": ["uv", "--directory", "C:/Users/andre/.config/opencode/mcp/telegram", "run", "main.py"],
            "environment": {
                "TELEGRAM_API_ID": "{env:TELEGRAM_API_ID}",
                "TELEGRAM_API_HASH": "{env:TELEGRAM_API_HASH}",
                "TELEGRAM_SESSION_STRING": "{env:TELEGRAM_SESSION_STRING}"
            }
        },
        "github": {
            "type": "local",
            "enabled": false,
            "command": [
                "C:/Users/andre/AppData/Local/Programs/github-mcp-server/github-mcp-server.exe",
                "stdio",
                "--toolsets=context,repos,pull_requests"
            ],
            "timeout": 30000
        },
        "firefox": {
            "type": "local",
            "enabled": false,
            "command": [
                "cargo",
                "run",
                "--quiet",
                "--release",
                "--manifest-path",
                "C:/Users/andre/.config/opencode/mcp/firefox/Cargo.toml",
                "--",
                "--allow-output-root",
                "C:/Users/andre/.config/opencode",
                "--allow-output-root",
                "C:/Users/andre/AppData/Local/Temp/opencode"
            ],
            "timeout": 30000
        }
    },
    "plugin": ["@slkiser/opencode-quota@3.11.1"]
}
